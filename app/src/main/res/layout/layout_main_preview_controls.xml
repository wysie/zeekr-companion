<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:orientation="vertical" android:gravity="end">
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical">
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_preview_record"
            style="@style/Widget.Cam.RailSmall" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:minHeight="48dp" android:maxWidth="260dp"
            android:text="@string/record_start" app:icon="@drawable/ic_record" android:visibility="gone" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_preview_expand"
            style="@style/Widget.Cam.IconButton" android:layout_width="48dp" android:layout_height="48dp"
            android:layout_marginStart="8dp" android:contentDescription="@string/main_expand_preview"
            app:icon="@drawable/ic_side_expand" />
    </LinearLayout>
    <TextView android:id="@+id/expanded_camera_status" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:maxWidth="360dp" android:minHeight="48dp"
        android:layout_marginTop="8dp" android:padding="10dp" android:gravity="center_vertical"
        android:textAppearance="@style/TextAppearance.Cam.Body" android:textColor="@color/text_primary"
        android:background="@drawable/bg_chip_neutral" android:clickable="true" android:focusable="true"
        android:visibility="gone" />
</LinearLayout>
