<?xml version="1.0" encoding="utf-8"?>
<!--
  设置：统一骨架的 ① 标题区 · ② 列表栏 · ③ 内容区 · ⑤ 状态条（见 docs/ui-spec.md）。

  ① 横跨两栏，因为「设置」是一屏，不是两屏。它的左键跟着深度变：
  停在分区层是菜单（拉开抽屉），进了二级界面是返回（退一层）——
  位置永远是这一个，规范第一条原则。

  ② 左栏固定宽度（list_width，和车机系统设置的左栏同一比例）：分区名都很短，
  给它一个稳定的宽度，右栏才不会因为换分区而变宽变窄。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- ① 标题区 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="16dp">

        <LinearLayout android:layout_width="@dimen/list_width" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/settings_nav" style="@style/Widget.Cam.IconButton" android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="@string/cd_menu" app:icon="@drawable/ic_menu" />
            <ImageView android:layout_width="26dp" android:layout_height="26dp" android:layout_marginStart="6dp" android:layout_marginEnd="8dp" android:src="@drawable/ic_companion_mark" android:importantForAccessibility="no" />
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/main_brand_name" android:textAppearance="@style/TextAppearance.Cam.SettingsMicro" android:textColor="@color/text_primary" />
        </LinearLayout>

        <TextView
            android:id="@+id/settings_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/nav_settings"
            android:textAppearance="@style/TextAppearance.Cam.SettingsTitle"
            android:textColor="@color/text_primary"
            android:fontFamily="sans-serif" />
        <com.google.android.material.button.MaterialButton android:id="@+id/in_app_record_stop" style="@style/Widget.Cam.IconButton" android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="@string/record_stop" app:icon="@drawable/ic_record_stop" app:iconTint="@color/recording_text" android:visibility="gone" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/line" />

    <LinearLayout android:id="@+id/settings_camera_changes" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="8dp"
        android:background="@color/sunken" android:visibility="gone">
        <TextView android:id="@+id/settings_pending_changes" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:paddingTop="8dp" android:paddingBottom="8dp" android:paddingStart="0dp" android:paddingEnd="12dp"
            android:text="@string/ui_pending_camera_changes" android:textAppearance="@style/TextAppearance.Cam.Caption"
            android:textColor="@color/text_primary" android:accessibilityLiveRegion="polite" />
        <com.google.android.material.button.MaterialButton android:id="@+id/settings_apply_cameras"
            style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:minHeight="48dp" android:minWidth="48dp"
            android:textAppearance="@style/TextAppearance.Cam.Caption" android:textAllCaps="false"
            android:text="@string/camera_apply_action" android:textColor="@color/energy_text" />
    </LinearLayout>

    <androidx.slidingpanelayout.widget.SlidingPaneLayout
        android:id="@+id/settings_sliding_pane"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/bg">

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/settings_headers"
            android:layout_width="@dimen/list_width"
            android:layout_height="match_parent"
            android:background="@color/bg" />

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/settings_detail"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent" />
    </androidx.slidingpanelayout.widget.SlidingPaneLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/line" />

    <!-- ⑤ 状态条：和主界面同一条 -->
    <include
        layout="@layout/layout_status_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
