<?xml version="1.0" encoding="utf-8"?>
<!--
  wysie's introduction and direct source credits come first. Community thanks
  inherited from dts88 are attributed separately. All content scrolls and uses
  semantic day/night colours; source and GPL links remain visible.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/title_bar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/about_close"
            style="@style/Widget.Cam.IconButton"
            android:layout_width="@dimen/icon_button_size"
            android:layout_height="@dimen/icon_button_size"
            android:contentDescription="@string/action_back"
            app:icon="@drawable/ic_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:text="@string/about_title"
            android:textColor="@color/text_primary"
            android:textAppearance="@style/TextAppearance.Cam.Title"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/line" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="28dp"
        android:paddingTop="20dp"
        android:paddingEnd="28dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/about_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textAppearance="@style/TextAppearance.Cam.Body" />

            <TextView
                android:id="@+id/about_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:lineSpacingMultiplier="1.25"
                android:text="@string/about_tagline"
                android:textColor="@color/text_primary"
                android:textAppearance="@style/TextAppearance.Cam.Body" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/about_credits_title"
                android:textColor="@color/text_primary"
                android:textAppearance="@style/TextAppearance.Cam.Row"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingMultiplier="1.3"
                android:text="@string/about_credits_dts88"
                android:textColor="@color/text_secondary"
                android:textAppearance="@style/TextAppearance.Cam.Body" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingMultiplier="1.3"
                android:text="@string/about_credits_ferix"
                android:textColor="@color/text_secondary"
                android:textAppearance="@style/TextAppearance.Cam.Body" />

            <TextView
                android:id="@+id/about_link_ferix"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:minHeight="48dp"
                android:gravity="center_vertical"
                android:padding="4dp"
                android:focusable="true"
                android:text="github.com/FerixzTanz/CAMCORDER"
                android:textColor="@color/energy_text"
                android:textAppearance="@style/TextAppearance.Cam.Body" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingMultiplier="1.3"
                android:text="@string/about_credits_evcam"
                android:textColor="@color/text_secondary"
                android:textAppearance="@style/TextAppearance.Cam.Body" />

            <TextView
                android:id="@+id/about_link_evcam"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:padding="4dp"
                android:text="github.com/suyunkai/EVCam"
                android:textColor="@color/energy_text"
                android:textAppearance="@style/TextAppearance.Cam.Body" />

            <TextView
                android:id="@+id/about_link_gpl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:padding="4dp"
                android:text="gnu.org/licenses/gpl-3.0.html"
                android:textColor="@color/energy_text"
                android:textAppearance="@style/TextAppearance.Cam.Body" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/about_project_title"
                android:textColor="@color/text_primary"
                android:textAppearance="@style/TextAppearance.Cam.Row"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingMultiplier="1.3"
                android:text="@string/about_project_body"
                android:textColor="@color/text_secondary"
                android:textAppearance="@style/TextAppearance.Cam.Body" />

            <TextView
                android:id="@+id/about_link_project"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:padding="4dp"
                android:minHeight="48dp"
                android:gravity="center_vertical"
                android:focusable="true"
                android:text="@string/about_link_fork_label"
                android:textColor="@color/energy_text"
                android:textAppearance="@style/TextAppearance.Cam.Body" />

            <TextView
                android:id="@+id/about_link_upstream"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:minHeight="48dp"
                android:gravity="center_vertical"
                android:padding="4dp"
                android:focusable="true"
                android:text="@string/about_link_upstream_label"
                android:textColor="@color/energy_text"
                android:textAppearance="@style/TextAppearance.Cam.Body" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/about_thanks_title"
                android:textColor="@color/text_primary"
                android:textAppearance="@style/TextAppearance.Cam.Row"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingMultiplier="1.3"
                android:text="@string/about_thanks_body"
                android:textColor="@color/text_secondary"
                android:textAppearance="@style/TextAppearance.Cam.Body" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/about_privacy_title"
                android:textColor="@color/text_primary"
                android:textAppearance="@style/TextAppearance.Cam.Row"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingMultiplier="1.3"
                android:text="@string/about_privacy_body"
                android:textColor="@color/text_secondary"
                android:textAppearance="@style/TextAppearance.Cam.Body" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/about_storage_title"
                android:textColor="@color/text_primary"
                android:textAppearance="@style/TextAppearance.Cam.Row"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingMultiplier="1.3"
                android:text="@string/about_storage_body"
                android:textColor="@color/text_secondary"
                android:textAppearance="@style/TextAppearance.Cam.Body" />

            <TextView
                android:id="@+id/about_safety_heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/about_safety_title"
                android:textColor="@color/text_primary"
                android:textAppearance="@style/TextAppearance.Cam.Row"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingMultiplier="1.3"
                android:text="@string/about_safety_body"
                android:textColor="@color/text_secondary"
                android:textAppearance="@style/TextAppearance.Cam.Body" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/about_coffee_title"
                android:textColor="@color/text_primary"
                android:textAppearance="@style/TextAppearance.Cam.Row"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingMultiplier="1.3"
                android:text="@string/about_coffee_body"
                android:textColor="@color/text_secondary"
                android:textAppearance="@style/TextAppearance.Cam.Body" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
