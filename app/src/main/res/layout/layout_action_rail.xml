<?xml version="1.0" encoding="utf-8"?>
<HorizontalScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
 android:id="@+id/action_rail" android:layout_width="match_parent" android:layout_height="wrap_content" android:fillViewport="true" android:paddingTop="8dp" android:background="@drawable/bg_home_toolbar" android:scrollbars="horizontal">
 <LinearLayout android:id="@+id/main_dock_actions" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
    <FrameLayout
        android:id="@+id/btn_start_record"
        android:layout_width="0dp" android:layout_weight="1.6"
        android:layout_height="wrap_content"
        android:minHeight="80dp"
        android:clickable="true"
        android:contentDescription="@string/record_start"
        android:focusable="true"
        android:background="@android:color/transparent"
        android:foreground="@drawable/bg_home_toolbar_feedback">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="80dp"
            android:paddingTop="12dp" android:paddingBottom="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal" android:baselineAligned="false"
            android:paddingStart="12dp"
            android:paddingEnd="16dp">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/record_ring"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:max="1000"
                    android:progress="0"
                    app:indicatorColor="@color/recording"
                    app:indicatorSize="48dp"
                    app:trackColor="@color/recording_track"
                    app:trackCornerRadius="2dp"
                    app:trackThickness="4dp" />

                <!-- 形状在代码里画：圆角半径和缩放一起动，就是圆 ⇄ 方 -->
                <View
                    android:id="@+id/record_dot"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/record_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="4"
                    android:text="@string/record_start"
                    android:textColor="@color/text_primary"
                    android:textAppearance="@style/TextAppearance.Cam.Body"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/record_detail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFeatureSettings="tnum"
                    android:maxLines="4"
                    android:textColor="@color/text_secondary"
                    android:textAppearance="@style/TextAppearance.Cam.Caption" />

                <!-- 录制中才有：熄屏后这段录像会怎样（自己读设置和这一次录像里有没有环视，熄屏 v3 起不看哨兵模式；RecordButtonUi 管显隐） -->
                <com.kooo.evcam.ui.ScreenOffHintView
                    android:id="@+id/record_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:maxLines="4"
                    android:textColor="@color/text_secondary"
                    android:textAppearance="@style/TextAppearance.Cam.Micro"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
  <com.google.android.material.button.MaterialButton android:id="@+id/btn_take_photo" style="@style/Widget.Cam.HomeToolbarAction" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:minHeight="80dp" android:layout_marginStart="8dp" android:text="@string/rail_photo" app:icon="@drawable/ic_camera" />
  <com.google.android.material.button.MaterialButton android:id="@+id/btn_main_gallery" style="@style/Widget.Cam.HomeToolbarAction" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:minHeight="80dp" android:layout_marginStart="8dp" android:text="@string/home_gallery" app:icon="@drawable/ic_photo" />
  <com.google.android.material.button.MaterialButton android:id="@+id/btn_main_windows" style="@style/Widget.Cam.HomeToolbarAction" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:minHeight="80dp" android:layout_marginStart="8dp" android:text="@string/main_windows" app:icon="@drawable/ic_home_windows" />
  <com.kooo.evcam.ui.FisheyeToggleButton android:id="@+id/btn_fisheye" app:flatToolbarAppearance="true" app:icon="@drawable/ic_home_straighten" style="@style/Widget.Cam.HomeToolbarAction" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:minHeight="80dp" android:layout_marginStart="8dp" android:text="@string/main_straighten_preview" />
 </LinearLayout>
</HorizontalScrollView>
