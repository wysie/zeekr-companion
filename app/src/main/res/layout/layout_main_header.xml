<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
 android:id="@+id/main_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="8dp">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:baselineAligned="false">
  <com.google.android.material.button.MaterialButton android:id="@+id/btn_menu" style="@style/Widget.Cam.IconButton" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginEnd="8dp" android:contentDescription="@string/cd_menu" app:icon="@drawable/ic_menu" />
  <ImageView android:layout_width="32dp" android:layout_height="32dp" android:layout_marginEnd="8dp" android:src="@drawable/ic_companion_mark" android:importantForAccessibility="no" />
  <TextView android:id="@+id/main_brand" android:layout_width="0dp" android:layout_weight="0.8" android:layout_height="wrap_content" android:text="@string/main_brand_name" android:textAppearance="@style/TextAppearance.Cam.Body" android:textStyle="bold" android:textColor="@color/text_primary" android:paddingStart="0dp" android:paddingEnd="12dp" />
  <com.google.android.material.button.MaterialButton android:id="@+id/btn_preview_layout" style="@style/Widget.Cam.HomeAction" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:minHeight="56dp" android:text="@string/record_preview_layout" app:icon="@drawable/ic_expand_more" app:iconGravity="end" />
  <com.google.android.material.button.MaterialButton android:id="@+id/btn_bird_eye" style="@style/Widget.Cam.HomeAction" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginEnd="8dp" android:text="@string/main_360_view" android:contentDescription="@string/bird_eye_button_description" />
  <com.google.android.material.button.MaterialButton android:id="@+id/btn_settings" style="@style/Widget.Cam.IconButton" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginEnd="8dp" android:contentDescription="@string/rail_settings" app:icon="@drawable/ic_settings" />
  <com.google.android.material.button.MaterialButton android:id="@+id/btn_minimize" style="@style/Widget.Cam.IconButton" android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="@string/cd_minimize" app:icon="@drawable/ic_minimize" />
 </LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginTop="8dp">
  <TextView android:id="@+id/camera_status_chip" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="center_vertical" android:padding="8dp" android:background="@drawable/bg_camera_status" android:text="@string/camera_status_title" android:textAppearance="@style/TextAppearance.Cam.Caption" android:textColor="@color/text_primary" android:clickable="true" android:focusable="true" app:drawableEndCompat="@drawable/ic_chevron_right" android:drawablePadding="8dp" />
  <TextView android:id="@+id/tv_recording_stats" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:textAppearance="@style/TextAppearance.Cam.Caption" android:fontFeatureSettings="tnum" android:textColor="@color/text_primary" android:visibility="gone" />
  <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:gravity="end|center_vertical" android:orientation="vertical">
   <TextView android:id="@+id/tv_status_storage" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Cam.Caption" android:textColor="@color/text_secondary" />
   <TextView android:id="@+id/tv_composite_info" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Cam.Caption" android:textColor="@color/text_secondary" />
  </LinearLayout>
 </LinearLayout>
 <TextView android:id="@+id/main_preview_pending" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp" android:text="@string/ui_pending_camera_changes" android:textAppearance="@style/TextAppearance.Cam.Caption" android:textColor="@color/text_secondary" android:accessibilityLiveRegion="polite" android:visibility="gone" />
 <com.kooo.evcam.ui.VehicleStatusPanel android:id="@+id/vehicle_status_panel" android:layout_width="160dp" android:layout_height="64dp" android:layout_gravity="end" android:visibility="gone" />
</LinearLayout>
