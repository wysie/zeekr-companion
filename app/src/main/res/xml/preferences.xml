            <SeekBarPreference
                android:key="pref_side_popup_rotation_left"
                android:title="@string/set_side_popup_rotation_left_title"
                android:summary="@string/set_side_popup_rotation_summary"
                app:showSeekBarValue="true" />
            <SeekBarPreference
                android:key="pref_side_popup_rotation_right"
                android:title="@string/set_side_popup_rotation_right_title"
                android:summary="@string/set_side_popup_rotation_summary"
                app:showSeekBarValue="true" />
            <SwitchPreferenceCompat
                android:key="pref_side_popup_mirror"
                android:title="@string/set_side_popup_mirror_title"
                android:summary="@string/set_side_popup_mirror_summary" />
            <SwitchPreferenceCompat
                android:key="pref_side_camera_label"
                android:title="@string/set_rearview_camera_label_title"
                android:summary="@string/set_rearview_camera_label_summary" />
        </PreferenceScreen>
        <PreferenceScreen
            android:key="sub_side_window"
            android:title="@string/menu_popup_window"
            android:summary="@string/menu_popup_window_summary">
            <ListPreference
                android:key="pref_side_popup_aspect"
                android:title="@string/set_side_popup_aspect_title"
