                android:title="@string/set_side_popup_vertical_title"
                android:summary="@string/set_side_popup_vertical_summary"
                app:showSeekBarValue="true" />
            <Preference
                android:key="pref_side_window_guide"
                android:summary="@string/menu_popup_gestures"
                android:selectable="false" />
        </PreferenceScreen>
        <PreferenceScreen
            android:key="sub_side_hud"
            android:title="@string/set_sub_hud_title"
            android:summary="@string/set_sub_hud_summary">
