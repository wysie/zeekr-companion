            <Preference
                android:key="pref_side_hud_note"
                android:summary="@string/set_side_hud_note"
                android:selectable="false" />
            <ListPreference
                android:key="pref_side_popup_mirror_mode"
                android:dependency="pref_side_popup"
                android:title="@string/set_side_mirror_mode_title" />
