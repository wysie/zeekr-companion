                <SeekBarPreference
                    android:key="pref_hud_side_shape"
                    android:title="@string/set_hud_side_shape_title"
                    android:summary="@string/set_hud_side_shape_summary"
                    app:showSeekBarValue="true" />
                <SeekBarPreference
                    android:key="pref_hud_side_left"
                    android:title="@string/set_hud_side_left_title"
                    android:summary="@string/set_hud_side_left_summary"
                    app:showSeekBarValue="true" />
                <SeekBarPreference
                    android:key="pref_hud_side_vertical"
                    android:title="@string/set_hud_side_vertical_title"
                    android:summary="@string/set_hud_side_vertical_summary"
