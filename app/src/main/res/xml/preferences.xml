                android:key="group_hud_picture"
                android:title="@string/menu_picture">
                <SwitchPreferenceCompat
                    android:key="pref_hud_side_mirror"
                    android:title="@string/set_hud_side_mirror_title"
                    android:summary="@string/set_hud_side_mirror_summary" />
                <SeekBarPreference
                    android:key="pref_hud_side_contrast"
                    android:title="@string/set_hud_side_contrast_title"
                    android:summary="@string/set_hud_side_contrast_summary"
