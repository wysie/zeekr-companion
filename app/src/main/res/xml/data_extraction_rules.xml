<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- 开发者模式卸载重装后要关着：不让系统把它备份、再恢复回来（见 DeveloperMode） -->
        <exclude domain="sharedpref" path="developer_mode.xml"/>
        <exclude domain="sharedpref" path="recording_intent.xml"/>
        <!-- Footage and diagnostic files must not enter platform backups/transfers. -->
        <exclude domain="file" path="."/>
        <exclude domain="external" path="."/>
        <!-- TODO: Use <include> and <exclude> to control what is backed up.
        <include .../>
        <exclude .../>
        -->
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="developer_mode.xml"/>
        <exclude domain="sharedpref" path="recording_intent.xml"/>
        <!-- Footage and diagnostic files must not enter platform backups/transfers. -->
        <exclude domain="file" path="."/>
        <exclude domain="external" path="."/>
    </device-transfer>
    <!--
    <device-transfer>
        <include .../>
        <exclude .../>
    </device-transfer>
    -->
</data-extraction-rules>